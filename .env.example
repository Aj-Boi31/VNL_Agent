# Copy this file to .env and fill in your real keys.
# .env is gitignored -- never commit real keys.

# Highlightly Volleyball API -- https://highlightly.net/login
# Only needed when re-running ingestion/fetch_vnl_data.py
HIGHLIGHTLY_API_KEY=

# Gemini API -- https://aistudio.google.com/apikey
# Needed by the Django app (agent/gemini_agent.py) to answer questions
GEMINI_API_KEY=

# Optional: override the Gemini model if the default gets retired
# GEMINI_MODEL=gemini-3.6-flash
